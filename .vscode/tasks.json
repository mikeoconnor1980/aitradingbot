{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/src/TradePilot.Api"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Now listening on"
        }
      }
    },
    {
      "label": "Start UI",
      "type": "shell",
      "command": "$info = netstat -ano | Select-String ':4200 ' | Select-String 'LISTENING'; if ($info) { $p = ([int]($info.ToString().Trim() -split '\\s+')[-1]); try { [System.Diagnostics.Process]::GetProcessById($p).Kill(); Start-Sleep -Seconds 1 } catch {} }; npx ng serve",
      "options": {
        "cwd": "${workspaceFolder}/frontend/trading-ui"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(.*?)",
          "endsPattern": "bundle generation complete"
        }
      }
    },
    {
      "label": "Start Worker",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/src/TradePilot.Worker"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "AgentCheckInService started"
        }
      }
    },
    {
      "label": "Start Dev",
      "dependsOn": ["Start API", "Start UI", "Start Worker"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start TradingView",
      "type": "shell",
      "command": "taskkill /IM chrome.exe /F 2>$null; Start-Process 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe' -ArgumentList '--remote-debugging-port=9222','--user-data-dir=C:\\tmp\\chrome-debug-profile','https://www.tradingview.com/chart/uSi8PQzi/'; Write-Host 'Waiting for CDP...'; $i=0; while ($i -lt 15) { try { Invoke-RestMethod -Uri 'http://localhost:9222/json/version' -TimeoutSec 2 | Out-Null; Write-Host 'CDP ready on port 9222'; break } catch { Start-Sleep -Seconds 1; $i++ } }",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
